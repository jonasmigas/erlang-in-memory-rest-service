{erl_opts, [debug_info, warnings_as_errors]}.
{deps, [
    {cowboy, "2.9.0"},
    {jsx, "3.1.0"}
]}.

{shell, [
    {apps, [kv_store]},
    {config, "config/sys.config"}
]}.

%% The brief asks for rebar3 to build *and create deployments*, so the project
%% ships a relx release rather than only a shell target. `rebar3 release`
%% builds a development release that symlinks into _build; `rebar3 as prod
%% release` builds the self-contained tree the runtime image copies.
%%
%% sasl is deliberately not in the release: its remaining job is release_handler
%% for hot upgrades, which this project has no appup or relup path for, and
%% including it adds a supervisor progress report per child on every boot.
%%
%% The version here must track {vsn, ...} in src/kv_store.app.src.
{relx, [
    {release, {kv_store, "0.1.0"}, [kv_store]},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"},
    {mode, dev}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, {test, true}]}
    ]},
    %% prod mode implies include_erts, stripped debug info and no symlinks.
    {prod, [
        {relx, [{mode, prod}]}
    ]}
]}.
