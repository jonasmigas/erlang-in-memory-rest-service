{application, kv_store,
 [{description, "In-memory key-value HTTP REST store"},
  {vsn, "0.1.0"},
  {registered, []},
  {mod, {kv_store_app, []}},
  {applications,
   [kernel,
    stdlib,
    cowboy,
    jsx
   ]},
  %% The application's own default. application:get_env/2 finds it
  %% wherever kv_store is loaded, so no caller needs a fallback of
  %% its own and there is one literal to change.
  {env, [{port, 8080}]},
  {modules, []}
 ]}.
