%% Application configuration baked into the release (and picked up by
%% `rebar3 shell`). kv_http reads {kv_store, port} at listener start.
%%
%% The runtime image passes -kv_store port $APP_PORT, which overrides this,
%% so the container has a single place to change the port.
%%
%% The kernel logger is left at its default level: lowering it to info turns
%% on the OTP progress reports that default exists to suppress, which buries
%% real errors under a few hundred lines on every boot.
[
  {kv_store, [
    {port, 8080}
  ]}
].
