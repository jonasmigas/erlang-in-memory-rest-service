%% Deployment overrides, baked into the release and picked up by
%% `rebar3 shell`. Anything set here wins over the defaults in
%% kv_store.app.src.
%%
%% The port is deliberately not restated. Its default is in
%% kv_store.app.src and the runtime image passes -kv_store port
%% $APP_PORT, so repeating 8080 here would be a third literal that could
%% only ever drift from the other two.
%%
%% The kernel logger is left at its default level: lowering it to info turns
%% on the OTP progress reports that default exists to suppress, which buries
%% real errors under a few hundred lines on every boot.
[
].
